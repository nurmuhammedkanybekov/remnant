rules_version = '2';

// REMNANT cloud saves: one document per player, saves/{their user id}.
// Players can read and write only their own, and only a save-sized string.
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json', 'savedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 200000
        && request.resource.data.savedAt is int;
    }
  }
}
