{
  "name": "remnant",
  "private": true,
  "version": "0.5.0",
  "description": "First-person survival horror game in the browser, solo or two-player online co-op \u2014 TypeScript + Three.js.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test",
    "playtest": "node tools/playtest/run.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.166.0",
    "prettier": "^3.9.9",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "three": "^0.166.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
